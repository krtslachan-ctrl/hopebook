# Required in production (NODE_ENV=production). Weak defaults like admin123 are refused.
ADMIN_PASSWORD=change-me-to-a-strong-password

# Session signing secret (ADMIN_SECRET preferred; ADMIN_SESSION_SECRET also accepted)
ADMIN_SECRET=change-me-to-a-long-random-string

# Turso (libSQL) — required on Vercel serverless. If unset, local sql.js file DB is used.
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
